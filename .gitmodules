[submodule ".registry"]
	path = .registry
	url = https://github.com/btraven00/btraven00.r-universe.dev
	branch = HEAD
[submodule "BrailleR"]
	path = BrailleR
	url = https://github.com/ajrgodfrey/BrailleR
[submodule "clusterLibreville"]
	path = clusterLibreville
	url = https://github.com/btraven00/clust-libreville-rs
	branch = r-pkg
[submodule "glmjax"]
	path = glmjax
	url = https://github.com/btraven00/glm-jax
	subdir = r
[submodule "picklerick"]
	path = picklerick
	url = https://github.com/btraven00/scx
	subdir = r/picklerick
[submodule "scBrailleR"]
	path = scBrailleR
	url = https://github.com/btraven00/scBrailleR
[submodule "xlaport"]
	path = xlaport
	url = https://github.com/btraven00/xlaport
